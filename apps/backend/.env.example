# Server Configuration
PORT=4000
ENV=development

# Database Configuration
# DB_DRIVER: "sqlite" (default) or "postgres"
DB_DRIVER=sqlite
# For sqlite: path to the database file (e.g. ./data/cribyte.db)
# For postgres: connection string (e.g. postgres://user:password@localhost:5432/cribyte?sslmode=disable)
DATABASE_URL=./data/cribyte.db

# Storage Configuration
# STORAGE_DRIVER: "local" (default) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads

# S3 Configuration (only if STORAGE_DRIVER=s3)
STORAGE_S3_ENDPOINT=localhost:9000
STORAGE_S3_BUCKET=cribyte
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_USE_SSL=false

# Session / Security
SESSION_SECRET=your-random-32-byte-secret-key-change-me
SESSION_EXPIRY_HOURS=168

